{
  "name": "animegonet-webui",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "web:build": "tsc --project tsconfig.json",
    "web:check": "tsc --project tsconfig.json --noEmit",
    "web:test": "npm run web:build && node --test tests/web/*.test.mjs",
    "web:e2e": "playwright test --config playwright.config.mjs tests/web-e2e/release-container.spec.mjs",
    "web:e2e:full-chain": "playwright test --config playwright.config.mjs tests/web-e2e/full-chain-container.spec.mjs",
    "helper:e2e": "playwright test --config playwright.config.mjs tests/web-e2e/animegohelper-compat.spec.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "linkedom": "0.18.13",
    "typescript": "7.0.2"
  }
}
